{
  "manifest_version": 2,
  "name": "Distraction-Free Tab",
  "short_name": "Distraction-Free Tab",
  "version": "1.0.1",
  "description": "A calm new tab that keeps distractions away: site blocking on a schedule, daily limits, block-now sessions and a simple timer. Based on Tabliss.",
  "browser_specific_settings": {
    "gecko": {
      "id": "productivity-tab@gabrielsvieira01.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "chrome_settings_overrides": {
    "homepage": "index.html"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "web_accessible_resources": [
    "bloqueado.html"
  ],
  "browser_action": {
    "default_icon": {
      "32": "icons/32.png",
      "48": "icons/48.png",
      "96": "icons/96.png"
    },
    "default_title": "Distraction-Free Tab"
  }
}
